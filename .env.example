# Copy this file to .env and fill in your keys.
# .env is gitignored so your keys stay out of the repo.

# Which model the agent uses: "openai" or "bedrock"
MODEL_PROVIDER=openai
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=your-openai-key-here

# Bedrock uses your normal AWS credentials (AWS_PROFILE or env vars)
BEDROCK_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
AWS_REGION=us-east-1

PYDANTIC_AI_NO_BANNER=1

# Logfire (monitoring). Write token sends traces; read token is for querying them.
LOGFIRE_TOKEN=your-logfire-write-token
LOGFIRE_READ_TOKEN=your-logfire-read-token
